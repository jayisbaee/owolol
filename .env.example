# Discord bot credentials — from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: set this while developing so slash commands register instantly to one server.
# Leave blank to register globally (takes up to 1 hour to propagate, but works in every server).
GUILD_ID=

# Postgres connection string — Railway injects this automatically as DATABASE_URL
# when you add the Postgres plugin to your project. Locally you can point it at
# any Postgres instance (e.g. a free one from Railway, Neon, or a local install).
DATABASE_URL=postgresql://user:password@host:port/dbname

# Prefix for text-based commands, e.g. "jayjay coinflip 100 heads".
# Include a trailing space if you want one between the prefix and the command name.
# Leave unset to default to "jayjay ".
PREFIX=jayjay 

# Comma-separated list of Discord user IDs allowed to use admin economy commands
# (addmoney, removemoney, setmoney). Right-click your Discord profile with
# Developer Mode on to copy your ID.
ADMIN_IDS=123456789012345678
